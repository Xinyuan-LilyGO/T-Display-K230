diff --git a/buildroot-overlay/board/canaan/k230-soc/distribution/distribution.sh b/buildroot-overlay/board/canaan/k230-soc/distribution/distribution.sh
index 4c041830..cfabf39c 100755
--- a/buildroot-overlay/board/canaan/k230-soc/distribution/distribution.sh
+++ b/buildroot-overlay/board/canaan/k230-soc/distribution/distribution.sh
@@ -320,6 +320,38 @@ EOF
         printf 'Debian GNU/Linux 13 T-Display K230 tty1\n\n' \
             > "${distr_rootfs}/etc/issue"
     fi
+
+    if [ "${K230_CLI_MINIMAL:-0}" = "1" ]; then
+        local required_cli_path
+        for required_cli_path in \
+            usr/sbin/i2cdetect \
+            usr/sbin/i2cget \
+            usr/bin/loadkeys \
+            usr/bin/showkey \
+            etc/console-setup/t-display-k230.map \
+            etc/systemd/system/t-display-k230-keymap.service; do
+            if [ ! -e "${distr_rootfs}/${required_cli_path}" ]; then
+                print_red "Missing minimal CLI rootfs file: ${required_cli_path}"
+                exit 1
+            fi
+        done
+
+        if [ ! -L "${distr_rootfs}/etc/systemd/system/multi-user.target.wants/t-display-k230-keymap.service" ]; then
+            print_red "T-Display K230 keymap service is not enabled"
+            exit 1
+        fi
+        if ! grep -qF 'shift keycode  16 = apostrophe' \
+            "${distr_rootfs}/etc/console-setup/t-display-k230.map"; then
+            print_red "T-Display K230 Shift symbol layer is missing"
+            exit 1
+        fi
+        if ! find "${distr_rootfs}/usr/lib/riscv64-linux-gnu" \
+           -maxdepth 1 -name 'libkeymap.so*' -print -quit | grep -q .; then
+            if [ ! -x "${distr_rootfs}/usr/bin/loadkeys" ]; then
+                print_red "loadkeys and libkeymap are both missing from minimal CLI rootfs"
+                exit 1
+            fi
+        fi
+        print_green "Verified minimal CLI rootfs payload"
+    fi
 
     # Create /app symlink pointing to /root/app
     cd "${distr_rootfs}"
