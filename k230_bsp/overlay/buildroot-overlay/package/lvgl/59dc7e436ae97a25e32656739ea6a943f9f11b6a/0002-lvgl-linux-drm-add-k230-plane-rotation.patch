+static int plane_has_property(drm_dev_t * drm_dev, uint32_t plane_id, const char * name)
+{
+    drmModeObjectPropertiesPtr props;
+    uint32_t i;
+    int found = 0;
+
+    props = drmModeObjectGetProperties(drm_dev->fd, plane_id,
+                                       DRM_MODE_OBJECT_PLANE);
+    if(!props) {
+        return 0;
+    }
+
+    for(i = 0; i < props->count_props; i++) {
+        drmModePropertyPtr prop = drmModeGetProperty(drm_dev->fd,
+                                                     props->props[i]);
+        if(prop) {
+            if(!lv_strcmp(prop->name, name)) {
+                found = 1;
+            }
+            drmModeFreeProperty(prop);
+        }
+        if(found) {
+            break;
+        }
+    }
+
+    drmModeFreeObjectProperties(props);
+    return found;
+}
