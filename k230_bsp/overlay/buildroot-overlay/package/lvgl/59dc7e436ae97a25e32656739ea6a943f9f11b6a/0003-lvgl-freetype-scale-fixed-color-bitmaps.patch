diff -u -r a/lvgl/src/libs/freetype/lv_freetype_glyph.c b/lvgl/src/libs/freetype/lv_freetype_glyph.c
--- a/lvgl/src/libs/freetype/lv_freetype_glyph.c	2026-08-15 16:16:03.038799483 +0000
+++ b/lvgl/src/libs/freetype/lv_freetype_glyph.c	2026-08-15 16:16:24.803094956 +0000
@@ -207,13 +207,37 @@
     }
     else if(dsc->render_mode == LV_FREETYPE_FONT_RENDER_MODE_BITMAP) {
         FT_Bitmap * glyph_bitmap = &face->glyph->bitmap;
+        uint32_t bitmap_w = glyph_bitmap->width;
+        uint32_t bitmap_h = glyph_bitmap->rows;
 
-        dsc_out->adv_w = FT_F26DOT6_TO_INT(glyph->advance.x);        /*Width of the glyph in [pf]*/
-        dsc_out->box_h = glyph_bitmap->rows;                         /*Height of the bitmap in [px]*/
-        dsc_out->box_w = glyph_bitmap->width;                        /*Width of the bitmap in [px]*/
-        dsc_out->ofs_x = glyph->bitmap_left;                         /*X offset of the bitmap in [pf]*/
-        dsc_out->ofs_y = glyph->bitmap_top -
-                         dsc_out->box_h;                             /*Y offset of the bitmap measured from the as line*/
+        if(!FT_IS_SCALABLE(face) && bitmap_h > dsc->size && dsc->size > 0) {
+            uint32_t scaled_h = dsc->size;
+            uint32_t scaled_w = (bitmap_w * scaled_h + bitmap_h / 2) / bitmap_h;
+            int32_t scaled_top = (glyph->bitmap_top * (int32_t)scaled_h +
+                                  (int32_t)bitmap_h / 2) / (int32_t)bitmap_h;
+            int32_t scaled_left = 0;
+
+            if(scaled_w == 0) {
+                scaled_w = 1;
+            }
+            if(bitmap_w > 0) {
+                scaled_left = (glyph->bitmap_left * (int32_t)scaled_w) /
+                              (int32_t)bitmap_w;
+            }
+
+            dsc_out->adv_w = scaled_w;
+            dsc_out->box_h = scaled_h;
+            dsc_out->box_w = scaled_w;
+            dsc_out->ofs_x = scaled_left;
+            dsc_out->ofs_y = scaled_top - (int32_t)scaled_h;
+        }
+        else {
+            dsc_out->adv_w = FT_F26DOT6_TO_INT(glyph->advance.x);    /*Width of the glyph in [pf]*/
+            dsc_out->box_h = bitmap_h;                               /*Height of the bitmap in [px]*/
+            dsc_out->box_w = bitmap_w;                               /*Width of the bitmap in [px]*/
+            dsc_out->ofs_x = glyph->bitmap_left;                     /*X offset of the bitmap in [pf]*/
+            dsc_out->ofs_y = glyph->bitmap_top - dsc_out->box_h;      /*Y offset of the bitmap measured from the as line*/
+        }
         if(glyph->format == FT_GLYPH_FORMAT_BITMAP)
             dsc_out->format = LV_FONT_GLYPH_FORMAT_IMAGE;
         else
diff -u -r a/lvgl/src/libs/freetype/lv_freetype_image.c b/lvgl/src/libs/freetype/lv_freetype_image.c
--- a/lvgl/src/libs/freetype/lv_freetype_image.c	2026-08-15 16:16:03.039971842 +0000
+++ b/lvgl/src/libs/freetype/lv_freetype_image.c	2026-08-15 16:16:49.198141340 +0000
@@ -174,8 +174,10 @@
 
     FT_BitmapGlyph glyph_bitmap = (FT_BitmapGlyph)glyph;
 
-    uint16_t box_h = glyph_bitmap->bitmap.rows;         /*Height of the bitmap in [px]*/
-    uint16_t box_w = glyph_bitmap->bitmap.width;        /*Width of the bitmap in [px]*/
+    uint32_t src_h = glyph_bitmap->bitmap.rows;         /*Height of the bitmap in [px]*/
+    uint32_t src_w = glyph_bitmap->bitmap.width;        /*Width of the bitmap in [px]*/
+    uint32_t box_h = src_h;
+    uint32_t box_w = src_w;
 
     lv_color_format_t col_format;
     if(glyph_bitmap->bitmap.pixel_mode == FT_PIXEL_MODE_BGRA) {
@@ -185,19 +187,52 @@
         col_format = LV_COLOR_FORMAT_A8;
     }
     uint32_t pitch = glyph_bitmap->bitmap.pitch;
+    if(src_w == 0 || src_h == 0) {
+        FT_Done_Glyph(glyph);
+        lv_mutex_unlock(&dsc->cache_node->face_lock);
+        LV_PROFILER_FONT_END;
+        return false;
+    }
+    if(!FT_IS_SCALABLE(face) && src_h > dsc->size && dsc->size > 0) {
+        box_h = dsc->size;
+        box_w = (src_w * box_h + src_h / 2) / src_h;
+        if(box_w == 0) {
+            box_w = 1;
+        }
+    }
     uint32_t stride = lv_draw_buf_width_to_stride(box_w, col_format);
     data->draw_buf = lv_draw_buf_create_ex(font_draw_buf_handlers, box_w, box_h, col_format, stride);
     if(!data->draw_buf) {
         LV_LOG_WARN("Could not create draw buffer");
         FT_Done_Glyph(glyph);
+        lv_mutex_unlock(&dsc->cache_node->face_lock);
         LV_PROFILER_FONT_END;
         return false;
     }
     lv_draw_buf_clear(data->draw_buf, NULL);
 
-    for(int y = 0; y < box_h; ++y) {
-        lv_memcpy((uint8_t *)(data->draw_buf->data) + y * stride, glyph_bitmap->bitmap.buffer + y * pitch,
-                  pitch);
+    uint32_t px_size = col_format == LV_COLOR_FORMAT_ARGB8888 ? 4U : 1U;
+    int32_t signed_pitch = glyph_bitmap->bitmap.pitch;
+    uint32_t abs_pitch = signed_pitch < 0 ? (uint32_t)(-signed_pitch) : (uint32_t)signed_pitch;
+    for(uint32_t y = 0; y < box_h; ++y) {
+        uint32_t sy = (y * src_h) / box_h;
+        const uint8_t * src_row;
+        uint8_t * dst_row = (uint8_t *)(data->draw_buf->data) + y * stride;
+
+        if(signed_pitch < 0) {
+            src_row = glyph_bitmap->bitmap.buffer + (src_h - 1U - sy) * abs_pitch;
+        }
+        else {
+            src_row = glyph_bitmap->bitmap.buffer + sy * pitch;
+        }
+
+        for(uint32_t x = 0; x < box_w; ++x) {
+            uint32_t sx = (x * src_w) / box_w;
+            const uint8_t * src_px = src_row + sx * px_size;
+            uint8_t * dst_px = dst_row + x * px_size;
+
+            lv_memcpy(dst_px, src_px, px_size);
+        }
     }
 
     lv_draw_buf_flush_cache(data->draw_buf, NULL);
