From 37b66b38b9a1a5489708097185b7efce12aa26a4 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Mon, 3 Aug 2026 09:30:00 +0000
Subject: [PATCH] ASoC: canaan: add external I2S output switch

The RM69A10 board revision can use an external MAX98357A amplifier on the K230
I2S pads:

- BCLK: GPIO32
- LRCK/WS: GPIO33
- DATA/DIN: GPIO35
- SHUTDOWN: GPIO34, handled from userspace

The upstream K230 INNO machine driver already provides the runtime "Codec
Route" enum and the device-tree route property. Add the boolean mixer alias
used by the phone UI, and re-apply the selected route when a stream starts.
RM69A10 defaults to the external route so the phone UI can drive the MAX98357A
after boot, while the UI can still switch the route back to the internal
codec/headphone output.
---
 arch/riscv/boot/dts/canaan/k230-canmv-rm69a10.dts |  1 +
 sound/soc/canaan/canaan_k230_inno.c               | 29 ++++++++++++++++++++--
 2 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/arch/riscv/boot/dts/canaan/k230-canmv-rm69a10.dts b/arch/riscv/boot/dts/canaan/k230-canmv-rm69a10.dts
--- a/arch/riscv/boot/dts/canaan/k230-canmv-rm69a10.dts
+++ b/arch/riscv/boot/dts/canaan/k230-canmv-rm69a10.dts
@@ -35,6 +35,7 @@
 		canaan,model                = "K230_I2S_INNO";
 		canaan,k230-i2s-controller  = <&i2s>;
 		canaan,k230-audio-codec     = <&inno_codec>;
+		canaan,external-i2s-output-default;
 	};
 };
 &uart0 { status = "okay"; };
diff --git a/sound/soc/canaan/canaan_k230_inno.c b/sound/soc/canaan/canaan_k230_inno.c
--- a/sound/soc/canaan/canaan_k230_inno.c
+++ b/sound/soc/canaan/canaan_k230_inno.c
@@ -71,6 +71,13 @@
 	struct snd_soc_card card;
 };
 
+static void k230_inno_apply_output_route(struct k230_inno_info *priv)
+{
+	audio_i2s_in_init();
+	audio_i2s_enable_audio_codec(priv->route_internal);
+	audio_i2s_out_init(true, 32);
+}
+
 static int k230_inno_hw_params(struct snd_pcm_substream *substream,
 			       struct snd_pcm_hw_params *params)
 {
@@ -95,6 +102,8 @@
 	unsigned int max_ch;
 	int ret;
 
+	k230_inno_apply_output_route(priv);
+
 	/*
 	 * The CPU DAI advertises whatever I2S_COMP_PARAM_1 reports, which can
 	 * be more than the audio_in block actually feeds it: sdi0 and sdi1 are
@@ -179,9 +188,33 @@
 	return ret;
 }
 
+static int k230_external_i2s_get(struct snd_kcontrol *kcontrol,
+				 struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_card *card = snd_kcontrol_chip(kcontrol);
+	struct k230_inno_info *priv = snd_soc_card_get_drvdata(card);
+
+	ucontrol->value.integer.value[0] = !priv->route_internal;
+
+	return 0;
+}
+
+static int k230_external_i2s_put(struct snd_kcontrol *kcontrol,
+				 struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_ctl_elem_value route = *ucontrol;
+
+	route.value.enumerated.item[0] =
+		ucontrol->value.integer.value[0] ? 1 : 0;
+
+	return k230_codec_route_put(kcontrol, &route);
+}
+
 static const struct snd_kcontrol_new canaan_k230_inno_controls[] = {
 	SOC_ENUM_EXT("Codec Route", k230_codec_route_enum,
 		     k230_codec_route_get, k230_codec_route_put),
+	SOC_SINGLE_BOOL_EXT("External I2S Output Switch", 0,
+			    k230_external_i2s_get, k230_external_i2s_put),
 };
 
 static const struct snd_soc_ops canaan_k230_inno_ops = {
@@ -360,9 +393,7 @@
 	 * Establish the route before the card goes live, so the very first
 	 * open already sees the configuration asked for in the device tree.
 	 */
-	audio_i2s_in_init();
-	audio_i2s_enable_audio_codec(priv->route_internal);
-	audio_i2s_out_init(true, 32);
+	k230_inno_apply_output_route(priv);
 
 	ret = devm_snd_soc_register_card(&pdev->dev, card);
 	if (ret) {
-- 
2.25.1
