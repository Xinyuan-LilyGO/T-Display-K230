+static int canaan_panel_bl_update_status(struct backlight_device *bl)
+{
+	struct canaan_panel *ctx = bl_get_data(bl);
+	int brightness;
+	u8 level;
+	int ret;
+
+	if (!ctx || !ctx->dsi_command_backlight)
+		return 0;
+
+	brightness = backlight_get_brightness(bl);
+	if (brightness < 0)
+		brightness = 0;
+	if (brightness > ctx->max_brightness)
+		brightness = ctx->max_brightness;
+	if (brightness > 255)
+		brightness = 255;
+	level = brightness;
+
+	if (!ctx->prepared)
+		return 0;
+
+	ret = mipi_dsi_dcs_write(ctx->dsi, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+				 &level, 1);
+	if (ret < 0)
+		dev_err(ctx->panel.dev, "failed to set DSI brightness: %d\n", ret);
+
+	return ret < 0 ? ret : 0;
+}
+
+static const struct backlight_ops canaan_panel_bl_ops = {
+	.update_status = canaan_panel_bl_update_status,
+};
