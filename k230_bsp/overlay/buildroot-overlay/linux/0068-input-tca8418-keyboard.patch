From 2d89561a5c934225b98076f61e8a6d4caf801f26 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Fri, 6 Nov 2026 12:00:00 +0800
Subject: [PATCH] riscv: dts: rm69a10: enable TCA8418 keyboard on GPIO I2C

The keyboard connector routes SCL/SDA through IO46/IO47. The LilyGo
launcher accesses these pins with GPIO bit-banged I2C rather than the K230
hardware I2C4 controller, which remains connected to the camera on IO7/IO8.

Register an i2c-gpio adapter on gpio1 offsets 14/15, keep the TCA8418 out of
the camera I2C4 bus, and use the verified gpio1 offsets for IRQ and reset.
Remove the unused AHT20 node because it shares the keyboard bus pins.
---
 arch/riscv/boot/dts/canaan/k230-canmv-rm69a10.dts | 93 +++++++++++++++++----
 1 file changed, 84 insertions(+), 9 deletions(-)

diff --git a/arch/riscv/boot/dts/canaan/k230-canmv-rm69a10.dts b/arch/riscv/boot/dts/canaan/k230-canmv-rm69a10.dts
index 24ab252..01e06c0 100644
--- a/arch/riscv/boot/dts/canaan/k230-canmv-rm69a10.dts
+++ b/arch/riscv/boot/dts/canaan/k230-canmv-rm69a10.dts
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0 OR MIT
 #include "k230.dtsi"
 #include "display-rm69a10-568x1232.dtsi"
+#include <dt-bindings/input/input.h>
 / {
 	model = "Canaan CanMV-K230 with RM69A10 OLED";
 	compatible = "canaan,canmv-k230", "canaan,kendryte-k230";
@@ -38,6 +39,65 @@
 		canaan,k230-audio-codec     = <&inno_codec>;
 		canaan,external-i2s-output-default;
 	};
+
+	keyboard_i2c: i2c-gpio-keyboard {
+		compatible = "i2c-gpio";
+		pinctrl-names = "default";
+		pinctrl-0 = <&keyboard_i2c_gpio_pins>;
+		scl-gpios = <&gpio1_ports 14
+			     (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		sda-gpios = <&gpio1_ports 15
+			     (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <8>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		tca8418@34 {
+			compatible = "ti,tca8418";
+			reg = <0x34>;
+			interrupt-parent = <&gpio1_ports>;
+			interrupts = <10 IRQ_TYPE_EDGE_FALLING>;
+			keypad,num-rows = <7>;
+			keypad,num-columns = <10>;
+			autorepeat;
+			linux,keymap = <
+				MATRIX_KEY(0, 0, KEY_RIGHT) MATRIX_KEY(0, 1, KEY_LEFT)
+				MATRIX_KEY(0, 2, KEY_FN) MATRIX_KEY(0, 4, KEY_SPACE)
+				MATRIX_KEY(0, 5, KEY_TAB) MATRIX_KEY(0, 6, KEY_LEFTSHIFT)
+				MATRIX_KEY(0, 7, KEY_LEFTMETA) MATRIX_KEY(0, 8, KEY_FN)
+				MATRIX_KEY(0, 9, KEY_CAPSLOCK)
+				MATRIX_KEY(1, 0, KEY_MICMUTE) MATRIX_KEY(1, 1, KEY_DOWN)
+				MATRIX_KEY(1, 2, KEY_M) MATRIX_KEY(1, 3, KEY_SPACE)
+				MATRIX_KEY(1, 4, KEY_V) MATRIX_KEY(1, 5, KEY_C)
+				MATRIX_KEY(1, 6, KEY_X) MATRIX_KEY(1, 7, KEY_Z)
+				MATRIX_KEY(1, 8, KEY_LEFTALT) MATRIX_KEY(1, 9, KEY_Q)
+				MATRIX_KEY(2, 0, KEY_ENTER) MATRIX_KEY(2, 1, KEY_UP)
+				MATRIX_KEY(2, 2, KEY_LEFTCTRL) MATRIX_KEY(2, 3, KEY_N)
+				MATRIX_KEY(2, 4, KEY_B) MATRIX_KEY(2, 5, KEY_F)
+				MATRIX_KEY(2, 6, KEY_D) MATRIX_KEY(2, 7, KEY_S)
+				MATRIX_KEY(2, 8, KEY_A)
+				MATRIX_KEY(3, 1, KEY_L) MATRIX_KEY(3, 2, KEY_K)
+				MATRIX_KEY(3, 3, KEY_J) MATRIX_KEY(3, 4, KEY_H)
+				MATRIX_KEY(3, 5, KEY_G) MATRIX_KEY(3, 6, KEY_R)
+				MATRIX_KEY(3, 7, KEY_E) MATRIX_KEY(3, 8, KEY_W)
+				MATRIX_KEY(3, 9, KEY_ESC)
+				MATRIX_KEY(4, 0, KEY_BACKSPACE) MATRIX_KEY(4, 1, KEY_P)
+				MATRIX_KEY(4, 2, KEY_O) MATRIX_KEY(4, 3, KEY_I)
+				MATRIX_KEY(4, 4, KEY_U) MATRIX_KEY(4, 5, KEY_Y)
+				MATRIX_KEY(4, 6, KEY_T) MATRIX_KEY(4, 7, KEY_2)
+				MATRIX_KEY(4, 8, KEY_1) MATRIX_KEY(4, 9, KEY_F1)
+				MATRIX_KEY(5, 0, KEY_0) MATRIX_KEY(5, 1, KEY_9)
+				MATRIX_KEY(5, 2, KEY_8) MATRIX_KEY(5, 3, KEY_7)
+				MATRIX_KEY(5, 4, KEY_6) MATRIX_KEY(5, 5, KEY_5)
+				MATRIX_KEY(5, 6, KEY_4) MATRIX_KEY(5, 7, KEY_3)
+				MATRIX_KEY(5, 8, KEY_F3) MATRIX_KEY(5, 9, KEY_F2)
+				MATRIX_KEY(6, 0, KEY_F11) MATRIX_KEY(6, 1, KEY_F10)
+				MATRIX_KEY(6, 2, KEY_F9) MATRIX_KEY(6, 3, KEY_F8)
+				MATRIX_KEY(6, 4, KEY_F7) MATRIX_KEY(6, 5, KEY_F6)
+				MATRIX_KEY(6, 6, KEY_F5) MATRIX_KEY(6, 7, KEY_F4)
+			>;
+		};
+	};
 };
 &uart0 { status = "okay"; };
 &uart3 {
@@ -165,6 +225,14 @@
 		drive-strength = <8>;
 	};
 
+	keyboard_reset_gpio43_pins: keyboard_reset_gpio43_pins {
+		pins = K230_IO43;
+		function = K230_IO43_GPIO43;
+		output-enable;
+		bias-pull-up;
+		drive-strength = <8>;
+	};
+
 	keyboard_backlight_pwm4_pins: keyboard_backlight_pwm4_pins {
 		pins = K230_IO52;
 		function = K230_IO52_PWM4;
@@ -180,20 +248,22 @@
 		drive-strength = <8>;
 	};
 
-	aht20_i2c4_pins: aht20_i2c4_pins {
+	keyboard_i2c_gpio_pins: keyboard_i2c_gpio_pins {
 		scl {
 			pins = K230_IO46;
-			function = K230_IO46_I2C4_SCL;
+			function = K230_IO46_GPIO46;
 			bias-pull-up;
 			input-enable;
+			output-enable;
 			drive-strength = <8>;
 		};
 
 		sda {
 			pins = K230_IO47;
-			function = K230_IO47_I2C4_SDA;
+			function = K230_IO47_GPIO47;
 			bias-pull-up;
 			input-enable;
+			output-enable;
 			drive-strength = <8>;
 		};
 	};
@@ -232,7 +302,17 @@
 
 &gpio0 {
 	pinctrl-names = "default";
-	pinctrl-0 = <&keyboard_irq_gpio42_pins>;
+	pinctrl-0 = <&keyboard_irq_gpio42_pins
+		     &keyboard_reset_gpio43_pins>;
+};
+
+&gpio1_ports {
+	tca8418_reset_hog {
+		gpio-hog;
+		gpios = <11 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "tca8418-reset";
+	};
 };
 
 &pwm3_5 {
@@ -254,11 +335,6 @@
 		reg = <0x37>;
 		lens-focus = <&dw9714>;
 	};
-
-	aht20@38 {
-		compatible = "aosong,aht20", "aht20";
-		reg = <0x38>;
-	};
 };
 
 &mipi0 {
-- 
