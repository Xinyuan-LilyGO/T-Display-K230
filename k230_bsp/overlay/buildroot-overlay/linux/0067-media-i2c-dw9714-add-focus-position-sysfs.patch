 static const struct v4l2_subdev_ops dw9714_ops = {
 	.core = &dw9714_core_ops,
+};
+
+static ssize_t focus_position_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct dw9714_device *dw9714_dev = sd_to_dw9714_vcm(sd);
+
+	return sysfs_emit(buf, "%u\n", dw9714_dev->current_val);
+}
+
+static ssize_t focus_position_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct dw9714_device *dw9714_dev = sd_to_dw9714_vcm(sd);
+	unsigned long position;
+	int ret;
+
+	ret = kstrtoul(buf, 0, &position);
+	if (ret)
+		return ret;
+
+	if (position > DW9714_MAX_FOCUS_POS)
+		return -ERANGE;
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+
+	ret = dw9714_t_focus_vcm(dw9714_dev, position);
+	pm_runtime_put(dev);
+
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_RW(focus_position);
+
+static struct attribute *dw9714_attrs[] = {
+	&dev_attr_focus_position.attr,
+	NULL,
+};
+
+static const struct attribute_group dw9714_attr_group = {
+	.attrs = dw9714_attrs,
 };

